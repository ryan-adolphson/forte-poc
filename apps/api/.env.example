# Port the API listens on.
PORT=3000

# Postgres connection string. Required. This value matches compose.yaml.
DATABASE_URL=postgresql://forte:forte@127.0.0.1:5434/forte_search

# Gemini API key. Optional: the API starts without it, but chat will not work.
GEMINI_API_KEY=

# Gemini model the assistant uses.
GEMINI_MODEL=gemini-3.8-flash

# Chat requests allowed per client in each window.
CHAT_RATE_LIMIT=10

# Length of the rate-limit window, in seconds.
CHAT_RATE_TTL_SECONDS=60

# Reverse proxies in front of the API whose X-Forwarded-For is trusted for the client IP. 0 = none.
TRUST_PROXY=0

# Sign-in for the web app: one shared account. Optional, but nobody can sign in until both are set.
AUTH_USERNAME=forte-user
AUTH_PASSWORD=

# Signs the session cookie. Optional: when empty a random one is made at each start, so every restart signs everyone out.
SESSION_SECRET=

# Hours a sign-in lasts.
SESSION_TTL_HOURS=12

# Set to true only when the site is served over HTTPS. false works on http://localhost.
COOKIE_SECURE=false

# Sign-in attempts allowed per client IP per minute.
LOGIN_RATE_LIMIT=10
