  {
    "id": "table.products",
    "label": "Create table \"products\"",
    "summary": "Creates table \"products\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "products"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"products\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"products\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"products\"",
        "sql": "CREATE TABLE \"public\".\"products\" (\n  \"category\" text NOT NULL,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"name\" text NOT NULL,\n  \"properties\" jsonb NOT NULL,\n  \"sku\" text NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  \"visible_to_bot\" bool DEFAULT true NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"products\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"products\""
        ]
      }
    ]
  },
  {
    "id": "unique.products.products_sku_key",
    "label": "Add unique constraint on \"products\" (sku)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "products_sku_key",
        "table": "products"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"products_sku_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "products_sku_key",
          "public",
          "\"public\".\"products\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"products_sku_key\"",
        "sql": "ALTER TABLE \"public\".\"products\" ADD CONSTRAINT \"products_sku_key\" UNIQUE (\"sku\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"products_sku_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "products_sku_key",
          "public",
          "\"public\".\"products\""
        ]
      }
    ]
  }
