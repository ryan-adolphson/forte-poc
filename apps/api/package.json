{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:deploy": "prisma db migrate",
    "db:seed": "nest build && node dist/prisma/seed.js",
    "eval:scope": "nest build && node dist/chat/eval/scope-eval.js"
  },
  "dependencies": {
    "@forte/chat-contract": "*",
    "@google/genai": "^2.28.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@prisma/cli-engine": "0.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prisma": "8.0.0-rc.22",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
